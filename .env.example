# LIORA — konfiguracja frontendu.
# Frontend NIE przechowuje sekretów. Wszystkie wartości poniżej są publiczne.
# Tokeny JWT, klucze API, dane Telegrama i szyfrowanie realizuje backend.

# Adres bazowy API (backend LIORA).
VITE_API_BASE_URL="/api"

# Adres publiczny witryny — używany w linkach powrotnych i metadanych.
VITE_SITE_URL="https://liora.example"

# ---------------------------------------------------------------------------
# Backend (Lovable Cloud) — wartości publiczne, bezpieczne w bundlu klienta.
# Wstrzykiwane automatycznie przez środowisko; nazwy podane wyłącznie poglądowo.
# ---------------------------------------------------------------------------
# VITE_SUPABASE_URL=""
# VITE_SUPABASE_PUBLISHABLE_KEY=""
# VITE_SUPABASE_PROJECT_ID=""



# ---------------------------------------------------------------------------
# Zmienne WYŁĄCZNIE po stronie serwera (nigdy z prefiksem VITE_).
# Trzymane w menedżerze sekretów środowiska uruchomieniowego, nie w repozytorium.
# ---------------------------------------------------------------------------
# SUPABASE_URL=""                # ten sam adres co VITE_SUPABASE_URL, odczyt serwerowy
# SUPABASE_PUBLISHABLE_KEY=""    # klucz publiczny do odczytów serwerowych
# SUPABASE_SERVICE_ROLE_KEY=""   # NIGDY w kliencie; wyłącznie operacje uprzywilejowane
# SUPABASE_PROJECT_ID=""

# ---------------------------------------------------------------------------
# JWT_ISSUER="liora"
# JWT_AUDIENCE="liora-app"
# JWT_ALGORITHM="HS256"          # docelowo RS256 z kluczem rotowanym
# JWT_ACCESS_TTL="900"           # sekundy — czas życia tokenu dostępu
# JWT_SIGNING_SECRET=""          # sekret podpisu (min. 32 znaki)
# MAGIC_LINK_TTL="600"           # sekundy — ważność linku powrotnego
# MAGIC_LINK_REDIRECT_PATH="/powrot"
# SESSION_COOKIE_NAME="liora_session"
# MAIL_TRANSPORT_URL=""          # wysyłka linków powrotnych
# TELEGRAM_BOT_TOKEN=""
# TELEGRAM_CHAT_ID=""
# ---------------------------------------------------------------------------
# P0.14 — powiadomienia o rezerwacji (wyłącznie serwerowo, nigdy VITE_).
# ---------------------------------------------------------------------------
# EMAIL_SENDER_DOMAIN=""         # zweryfikowana subdomena nadawcy, np. notify.example.com
# STAFF_NOTIFICATION_EMAIL=""    # opcjonalny adres personelu; brak = brak powiadomienia staff

# ---------------------------------------------------------------------------
# P0.16 — realny transport e-mail przez HTTPS API (Cloudflare-compatible).
# Wyłącznie serwerowo; wartości trzymane w menedżerze sekretów, nie w repo.
# ---------------------------------------------------------------------------
# EMAIL_TRANSPORT="resend"       # "resend" (domyślnie) | "lovable" (legacy) | "none"
# EMAIL_API_KEY=""               # klucz API providera — NIGDY w kliencie
# EMAIL_SENDER_ADDRESS=""        # zweryfikowany adres nadawcy, np. no-reply@twojadomena
# EMAIL_SENDER_NAME=""           # opcjonalna nazwa nadawcy

# --- P0.30 Telegram Admin (server-only, nigdy VITE_*) ---
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_WEBHOOK_SECRET=
# "<telegram_id>:<supabase_user_id>,<telegram_id>:<supabase_user_id>"
TELEGRAM_ADMIN_ALLOWLIST=

# --- P0.30 Telegram Statistics (kanał read-only, osobny bot) ---
TELEGRAM_STATS_BOT_TOKEN=
TELEGRAM_STATS_WEBHOOK_SECRET=
# "<telegram_id>,<telegram_id>"
TELEGRAM_STATS_ALLOWLIST=

# Język komunikatów botów: pl | en
TELEGRAM_BOT_LANGUAGE=pl

# ---------------------------------------------------------------------------
# P0.38 — S3 STORAGE FOUNDATION (server-only, NIGDY z prefiksem VITE_).
# Magazyn systemowy: backups / releases / deployments / checkpoints /
# artifacts / logs, pod prefiksem `liora/`.
# Wartości sekretne pozostają PUSTE w repozytorium — wypełnia je wyłącznie
# menedżer sekretów środowiska uruchomieniowego.
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=garage
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
